# Course-only overlay of the exact backend used by the pinned course.
FROM ghcr.io/datadog/storedog/backend@sha256:c681ffd0e252f684a411832f3089c64a354e6c5a0eac93630ce53065997fe1e0
ARG DD_GIT_REPOSITORY_URL
ARG DD_GIT_COMMIT_SHA
ENV DD_GIT_REPOSITORY_URL=${DD_GIT_REPOSITORY_URL} DD_GIT_COMMIT_SHA=${DD_GIT_COMMIT_SHA}
# pg 1.3.0 ignores connect_timeout in async connect/reset (upstream ruby-pg #459).
# Change only this overlay's driver and lock entry; retain the base application.
ADD --checksum=sha256:d98f3dcb4a6ae29780a2219340cb0e55dbafbb7eb4ccc2b99f892f2569a7a61e https://rubygems.org/downloads/pg-1.4.6.gem /tmp/pg-1.4.6.gem
RUN gem install --local /tmp/pg-1.4.6.gem --no-document \
    && ruby -e 'p="/app/Gemfile.lock"; s=File.read(p); abort "Unexpected base pg version" unless s.include?("    pg (1.3.0)"); File.write(p,s.sub("    pg (1.3.0)","    pg (1.4.6)"))' \
    && cd /app && bundle check && rm /tmp/pg-1.4.6.gem
COPY config/database.yml /app/config/database.yml
COPY lib/pup_course /app/lib/pup_course
COPY lib/tasks/pup_course.rake /app/lib/tasks/pup_course.rake
